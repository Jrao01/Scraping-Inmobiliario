# Scraping URLs
rentahouseUrl=https://rentahouse.com.ve/buscar-propiedades
inmueblesConLupaurl=https://www.inmueblesconlupa.com/buscar

# Puppeteer / Chromium
CHROME_PATH=/usr/bin/chromium
PUPPETEER_SKIP_DOWNLOAD=true

# Server
PORT=3000
DEFAULT_PAGES=6
DEFAULT_SCRAPER_CLICKS=5

# --- Habitas Integration ---
# Generate a secure random token: openssl -hex 32
SCRAPER_API_KEY=your_scraper_api_key_here

# Backend API URL (use Docker hostname in production, localhost in dev)
HABITAS_API_URL=http://backend:5000

# This service URL (for self-reference if needed)
SCRAPER_SERVICE_URL=http://scraper:3000
